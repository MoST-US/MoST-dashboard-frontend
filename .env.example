# ============================================================
# MoST Dashboard environment template
# Copy this file to .env and edit the values for your setup.
# ============================================================

# ------------------------------------------------------------
# Frontend / API settings
# ------------------------------------------------------------
# Local development example:
#   browser calls the API through the SSH tunnel on the local machine
VITE_API_BASE_URL=http://127.0.0.1:4000
VITE_TUNNEL_MANAGER_URL=http://127.0.0.1:4100

# Public deployment behind a single domain / reverse proxy:
# VITE_API_BASE_URL=http://127.0.0.1:4000
# VITE_API_PROXY_PATH=/most-api
# VITE_TUNNEL_MANAGER_URL=/most-tunnel

# Ports exposed by the APIs that the frontend can switch between.
# The list is not limited to a fixed number of entries: add as many
# comma-separated ports as needed. When the selector cards are wider than
# the screen, the selector shows a horizontal scrollbar instead of
# wrapping onto additional rows.
VITE_API_PORTS=4000,4001,4002,4003,4004

# ------------------------------------------------------------
# SSH tunnel settings
# ------------------------------------------------------------
# Host inside the private network that is reachable through your SSH gateway.
# Example: c06
REMOTE_TUNNEL_HOST=c06

# SSH user and gateway.
# You can either embed the gateway in REMOTE_TUNNEL_USER or configure it separately.
REMOTE_TUNNEL_USER=matbwyler@172.16.46.6

# Single-port example:
# REMOTE_TUNNEL_PORT=4000

# Multi-port example (recommended when several APIs are exposed).
# The list is not limited: keep VITE_API_PORTS and REMOTE_TUNNEL_PORTS in
# sync with however many APIs you expose.
REMOTE_TUNNEL_PORTS=4000,4001,4002,4003,4004

# Actual target host behind the SSH tunnel.
# Usually leave blank and the app will use REMOTE_TUNNEL_HOST automatically.
REMOTE_TUNNEL_TARGET_HOST=

# Optional: define the gateway separately instead of placing it in REMOTE_TUNNEL_USER.
# REMOTE_TUNNEL_GATEWAY=172.16.46.6

# Optional: full SSH destination override (highest priority).
# Example: matbwyler@172.16.46.6
# REMOTE_TUNNEL_DESTINATION=

# ------------------------------------------------------------
# Local bind addresses
# ------------------------------------------------------------
# Use localhost for normal local-only access.
LOCAL_TUNNEL_BIND=127.0.0.1

# Set to 0.0.0.0 only if the forwarded API must be reachable by other machines.
# LOCAL_TUNNEL_BIND=0.0.0.0

# Bind the tunnel-manager API to the server network interface.
# Keep 127.0.0.1 if the dashboard runs only on this machine.
TUNNEL_MANAGER_BIND=127.0.0.1

# Tunnel-manager port.
TUNNEL_MANAGER_PORT=4100

# ------------------------------------------------------------
# Optional SSH override settings
# ------------------------------------------------------------
# SSH private key file (if needed):
# REMOTE_TUNNEL_IDENTITY_FILE=C:/Users/you/.ssh/id_rsa

# SSH config file (if needed):
# REMOTE_TUNNEL_SSH_CONFIG_FILE=C:/Users/you/.ssh/config

# Extra SSH flags:
# REMOTE_TUNNEL_EXTRA_ARGS=-o ServerAliveInterval=30

# ------------------------------------------------------------
# Optional experiment list
# ------------------------------------------------------------
# This is a predefined list used by the dashboard.
# Keep it unless you intentionally want to override the default selection set.
# It also defines the axes of the additive workload-profile matrix (`WORKLOAD_MIXES` runs), which
# draws every input/output combination listed here.
VITE_EXPERIMENT_LIST=1-100:1-100,1-100:100-300,1-100:300-600,1-100:600-1000,1-100:1000-1500,100-300:1-100,100-300:100-300,100-300:300-600,100-300:600-1000,100-300:1000-1500,300-600:1-100,300-600:100-300,300-600:300-600,300-600:600-1000,300-600:1000-1500,600-1000:1-100,600-1000:100-300,600-1000:300-600,600-1000:600-1000,600-1000:1000-1500